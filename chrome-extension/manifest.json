{
  "manifest_version": 3,
  "name": "PA Assistant - Canvas & Schedule Tracker",
  "version": "1.0.0",
  "description": "Phillips Academy personal assistant: track assignments, schedule, and get homework help",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://canvas.andover.edu/*",
    "https://andover.myschoolapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"],
      "css": ["styles/overlay.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "pages/sidebar.html"
  },
  "options_page": "pages/setup.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
